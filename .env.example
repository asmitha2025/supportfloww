# .env.example
MODEL_PATH=models/ticket_classifier
SLA_MODEL_PATH=models/sla_predictor/sla_xgb.json
ROUTE_THRESHOLD=0.80
CLARIFY_THRESHOLD=0.55
ENTROPY_MAX=0.35
PORT=7860
CORS_ALLOW_ORIGINS=*

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
LLM_ENABLED=true

# Runtime mode
# Windows defaults to sklearn fallback for stability. Set this only on machines
# where PyTorch/safetensors transformer loading has been verified.
SUPPORTMIND_FORCE_TRANSFORMER=0
SUPPORTMIND_DISABLE_TRANSFORMER=0
